# ---------------------------------------------------------------------------
# BaoTang360 – mẫu biến môi trường cho compose.prod.yaml (máy ảo Oracle Cloud).
# Chép thành .env.prod rồi điền giá trị thật. TUYỆT ĐỐI KHÔNG đưa .env.prod
# đã điền giá trị lên kho Git (đã có trong .gitignore).
#
# Sinh nhanh các bí mật:
#   openssl rand -hex 24          -> ANALYTICS_TOKEN, DB_PASSWORD
#   openssl rand -hex 32          -> PAYMENT_SANDBOX_SECRET
#   echo "base64:$(openssl rand -base64 32)"  -> APP_KEY
# ---------------------------------------------------------------------------

# Tên miền phục vụ TLS. Dùng <IP-công-cộng-thay-dấu-chấm-bằng-gạch>.sslip.io
# khi chưa có tên miền riêng, ví dụ: 152-67-10-20.sslip.io
APP_DOMAIN=

# Thư điện tử nhận cảnh báo hết hạn chứng thư TLS (nên điền)
ACME_EMAIL=

# Khoá mã hoá của Laravel – bắt buộc có tiền tố base64:
APP_KEY=

# MySQL chạy trong cùng compose
DB_DATABASE=baotang360
DB_USERNAME=baotang360
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Bí mật nội bộ
ANALYTICS_TOKEN=
PAYMENT_SANDBOX_SECRET=

# Mật khẩu các tài khoản mẫu do seeder tạo (admin/editor/visitor)
SEED_DEMO_PASSWORD=

# Thời gian giữ chỗ đơn hàng (phút)
ORDER_HOLD_MINUTES=15
