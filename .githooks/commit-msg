#!/usr/bin/env bash
# .githooks/commit-msg — từ chối commit không đúng Conventional Commits (Tài liệu kỹ thuật Mục 3.4)
# Kích hoạt: git config core.hooksPath .githooks
pattern='^(feat|fix|docs|refactor|test|chore|perf)(\([a-z0-9\-]+\))?: .{10,}'
if ! grep -qE "$pattern" "$1"; then
  echo "Thong diep commit khong dung quy uoc Conventional Commits." >&2
  echo "Vi du: feat(booking): them co che giu cho co thoi han" >&2
  exit 1
fi
