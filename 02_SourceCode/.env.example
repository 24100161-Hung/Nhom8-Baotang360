# BaoTang360 – mẫu biến môi trường cho docker compose (Tài liệu kỹ thuật Mục 3.3).
# Sao chép thành .env cùng thư mục compose.yaml rồi chỉnh. KHÔNG commit .env.
# Không chứa giá trị thật: biến để trống thì compose.yaml dùng giá trị mặc định cho môi trường học tập
# (vd DB_PASSWORD rỗng → mật khẩu mặc định của compose); khi triển khai thật phải đặt giá trị riêng.

# --- Ứng dụng ---
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
# Để trống: entrypoint tự sinh APP_KEY và lưu trong volume storage
APP_KEY=
APP_VERSION=1.0.0
LOG_STACK=daily
LOG_LEVEL=info

# --- Cơ sở dữ liệu MySQL 8 (cố định DB_CONNECTION=mysql, DB_HOST=db trong compose) ---
DB_CONNECTION=mysql
DB_DATABASE=baotang360
DB_USERNAME=baotang360
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Cổng publish ra máy host ---
APP_FORWARD_PORT=8080
DB_FORWARD_PORT=3307
ANALYTICS_FORWARD_PORT=8001

# --- Phiên & cookie ---
SESSION_DRIVER=database
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# --- Thư (ghi vào storage/logs, không gửi thật) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@baotang360.test

# --- Dịch vụ phân tích Python ---
ANALYTICS_URL=http://analytics:8001
ANALYTICS_TOKEN=

# --- Thanh toán: chỉ chế độ thử nghiệm; secret trống → tự sinh khi khởi động lần đầu ---
PAYMENT_GATEWAY=sandbox
PAYMENT_SANDBOX_SECRET=
ORDER_HOLD_MINUTES=15

# --- Bảo mật mạng ---
# Rỗng = không tin proxy nào; chỉ đặt "*" khi chạy sau proxy của nền tảng (Railway/Render)
TRUSTED_PROXIES=
FORCE_HTTPS=false

# --- Dữ liệu mẫu: trống → mật khẩu mặc định ghi trong tài liệu hướng dẫn ---
SEED_DEMO_PASSWORD=

# --- Triển khai PaaS (Railway/Render, image deploy/Dockerfile.web) ---
# DB_URL=mysql://user:pass@host:3306/baotang360   # thay cho DB_HOST/DB_USERNAME/...; Railway: ${{MySQL.MYSQL_URL}}
# PORT=8080                                       # nền tảng tự đặt
# APP_URL=                                        # để trống: suy ra từ RAILWAY_PUBLIC_DOMAIN / RENDER_EXTERNAL_URL
