        <env name="APP_LOCALE" value="vi"/>
        <env name="APP_FALLBACK_LOCALE" value="en"/>
        <env name="ANALYTICS_URL" value="http://analytics.invalid:8001" force="true"/>
        <env name="ANALYTICS_TOKEN" value="test-token"/>
        <env name="PAYMENT_SANDBOX_SECRET" value="test-sandbox-secret" force="true"/>
        <env name="ORDER_HOLD_MINUTES" value="15"/>
        <env name="FILESYSTEM_DISK" value="local"/>
