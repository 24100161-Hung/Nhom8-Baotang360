# Biến môi trường cho dịch vụ WEB trên Railway (dán vào Variables → Raw Editor). Image: 02_SourceCode/deploy/Dockerfile.web (ngữ cảnh build = gốc kho Git)
# ("tất cả trong một": nginx + php-fpm + scheduler + Python) – chỉ cần MỘT service web + MySQL + volume.
# ${{MySQL.X}} tham chiếu tới dịch vụ MySQL do Railway tạo. Đổi MỌI giá trị bí mật trước khi dán; không commit tệp đã điền.
RAILWAY_DOCKERFILE_PATH=02_SourceCode/deploy/Dockerfile.web
DB_URL=${{MySQL.MYSQL_URL}}
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=vi
# APP_URL để trống: entrypoint suy ra https://$RAILWAY_PUBLIC_DOMAIN
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true
FORCE_HTTPS=true
SEED_DEMO_PASSWORD=DOI-MAT-KHAU-TAI-KHOAN-MAU
# APP_KEY, PAYMENT_SANDBOX_SECRET, ANALYTICS_TOKEN: để trống → entrypoint tự sinh và lưu trong volume
# Volume: /var/www/html/storage/app (khóa, ảnh tải lên, tiles 360°, sao lưu)
